<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission caméra -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BestMlewi">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui"/>

        <!-- MainActivity (Launcher) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Consultation Orders -->
        <activity
            android:name=".ui.orders.Consultation_orders"
            android:exported="false"
            android:label="Gestion des Commandes"
            tools:ignore="UnusedAttribute" />

        <!-- AssignOrderActivity -->
        <activity
            android:name=".ui.orders.AssignOrderActivity"
            android:exported="false"
            android:label="Assigner Commande" />

        <!-- 🔥 FilterOrdersActivity (ajoutée ici, à l’intérieur de <application>) -->
        <activity
            android:name=".ui.orders.FilterOrdersActivity"
            android:exported="false"
            android:label="Filtrer les Commandes"
            tools:ignore="UnusedAttribute" />





    </application>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />


</manifest>