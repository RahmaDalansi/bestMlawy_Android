<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />


    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BestMlewi"
        tools:targetApi="31">

        <!-- Meta-data pour Google Play Services -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- CLÉ API GOOGLE MAPS (OBLIGATOIRE) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBGw9LoAOn4JfTequORtYOEosT_ZiQ_s3c" />

        <!-- ML Kit Barcode Scanner -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Login Activity comme activité principale -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.BestMlewi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register Activity -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.BestMlewi" />

        <!-- Employee Activity -->
        <activity
            android:name=".EmployeeActivity"
            android:exported="false"
            android:theme="@style/Theme.BestMlewi.NoActionBar" />

        <!-- Main Activity (pour les gérants) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BestMlewi.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activités employés -->
        <activity
            android:name=".ui.employee.Suppression"
            android:exported="false" />
        <activity
            android:name=".ui.employee.Modification"
            android:exported="false" />
        <activity
            android:name=".ui.employee.Ajout"
            android:exported="false" />
        <activity
            android:name=".ui.employee.Consultation"
            android:exported="false" />

        <activity
            android:name=".EmployeeDeliveryActivity"
            android:exported="false"
            android:theme="@style/Theme.BestMlewi.NoActionBar" />

        <!-- Consultation Orders -->
        <activity
            android:name=".ui.orders.Consultation_orders"
            android:exported="false"
            android:label="Gestion des Commandes"
            tools:ignore="UnusedAttribute" />

        <!-- AssignOrderActivity -->
        <activity
            android:name=".ui.orders.AssignOrderActivity"
            android:exported="false"
            android:label="Assigner Commande" />

        <!-- FilterOrdersActivity -->
        <activity
            android:name=".ui.orders.FilterOrdersActivity"
            android:exported="false"
            android:label="Filtrer les Commandes"
            tools:ignore="UnusedAttribute" />

        <!-- SalesPointDetailsActivity (activité ajoutée) -->
        <activity
            android:name=".ui.salespoints.SalesPointDetailsActivity"
            android:exported="false" />

    </application>

</manifest>