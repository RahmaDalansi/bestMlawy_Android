<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.BestMlewi" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Disable window title (optional) -->
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Alternative si vous avez besoin d’un thème sans action bar mais avec héritage clair -->
    <style name="Theme.BestMlewi.NoActionBar" parent="Theme.BestMlewi" />

    <!-- Overlay pour AppBar (ToolBar) -->
    <style name="Theme.BestMlewi.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- Overlay pour les menus contextuels -->
    <style name="Theme.BestMlewi.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>