<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardMaxElevation="16dp"
    app:contentPadding="0dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Commande ID - centré -->
            <TextView
                android:id="@+id/txtDialogOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commande #CMD001"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_gravity="center"
                android:layout_marginBottom="28dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05" />

            <!-- Informations commandes stylisées -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_section_bg"
                android:padding="16dp"
                android:layout_marginBottom="18dp"
                android:clipToPadding="false">

                <!-- Client -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Client"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:textStyle="normal" />
                    <TextView
                        android:id="@+id/txtDialogCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ali Ben Ahmed"
                        android:textSize="16sp"
                        android:textColor="#263238" />
                </LinearLayout>

                <!-- Montant total -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Montant total"
                        android:textSize="14sp"
                        android:textColor="#757575" />
                    <TextView
                        android:id="@+id/txtDialogTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12.500 DT"
                        android:textSize="18sp"
                        android:textColor="#2E7D32"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Statut -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Statut"
                        android:textSize="14sp"
                        android:textColor="#757575" />
                    <TextView
                        android:id="@+id/txtDialogStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En cours"
                        android:textSize="16sp"
                        android:textColor="#F57C00"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Date & Heure -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Date et Heure"
                        android:textSize="14sp"
                        android:textColor="#757575" />
                    <TextView
                        android:id="@+id/txtDialogTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24/11/2025 18:30"
                        android:textSize="15sp"
                        android:textColor="#546E7A" />
                </LinearLayout>
            </LinearLayout>

            <!-- Articles commandés -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Articles commandés"
                android:textStyle="bold"
                android:textColor="#455A64"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium" />

            <!-- ListView des articles -->
            <ListView
                android:id="@+id/lstOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="10dp"
                android:background="@drawable/rounded_list_bg"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:layout_marginBottom="20dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="ifContentScrolls" />

            <!-- Boutons d'action avec coins arrondis -->
            <Button
                android:id="@+id/btnMarkReady"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marquer comme prêt"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="14dp"
                android:layout_marginBottom="10dp"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />

            <Button
                android:id="@+id/btnMarkDelivered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marquer comme livré"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="14dp"
                android:layout_marginBottom="10dp"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnDeleteOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Supprimer la commande"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="14dp"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>