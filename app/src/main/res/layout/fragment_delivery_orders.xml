<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Barre de titre moderne -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#C7C6C6"
        android:paddingHorizontal="22dp"
        android:gravity="center_vertical"
        android:elevation="6dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Scan to complete order"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:letterSpacing="0.05" />

        <ImageView
            android:id="@+id/imgScanQr"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_qr_code"
            android:background="@drawable/bg_icon_circle"
            android:padding="12dp"
            android:contentDescription="Scanner un code QR"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- RecyclerView pour afficher les commandes -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/orders_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp" />

            <!-- Message quand il n'y a pas de commandes -->
            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Aucune commande assignée"
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Message d'erreur -->
            <TextView
                android:id="@+id/tv_error_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Erreur de chargement"
                android:textSize="16sp"
                android:textColor="#FF0000"
                android:gravity="center"
                android:visibility="gone" />

        </RelativeLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>