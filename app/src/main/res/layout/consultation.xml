<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#f5f5f5">

        <!-- ScrollView pour tout le contenu -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <!-- Content Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Our Employee section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txtOurEmployee"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Our Employee:"
                        android:textSize="16sp"
                        android:textColor="#000000" />

                    <Button
                        android:id="@+id/btnAddEmployee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add Employee"
                        android:background="@drawable/button_grey"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:textAllCaps="false" />

                </LinearLayout>

                <!-- FILTER SECTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/filter_background"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Role"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        >

                        <!-- Utilisation de MaterialButton pour un meilleur style -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterCollaborator"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:text="Collaborator"
                            android:textSize="9sp"
                            android:layout_marginEnd="4dp"
                            android:padding="5sp"
                            app:strokeColor="@color/gray_400"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp"
                            android:textColor="@color/gray_600"
                            android:backgroundTint="@android:color/transparent"
                            android:textStyle="bold"/>

                        <com.google.android.material.button.MaterialButton
                            android:textStyle="bold"
                            android:id="@+id/btnFilterDeliver"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:text="Deliver"
                            android:textSize="9sp"
                            android:layout_marginEnd="4dp"
                            app:strokeColor="@color/gray_400"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp"
                            android:textColor="@color/gray_600"
                            android:backgroundTint="@android:color/transparent" />

                        <com.google.android.material.button.MaterialButton
                            android:textStyle="bold"
                            android:id="@+id/btnFilterCoordinator"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="10dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:text="Coordinator"
                            android:textSize="9sp"
                            app:strokeColor="@color/gray_400"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp"
                            android:textColor="@color/gray_600"
                            android:backgroundTint="@android:color/transparent" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Search section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Search by name employee"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/edtSearch"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:hint="Enter employee name..."
                            android:textSize="14sp"
                            android:textColor="#000000"
                            android:background="@drawable/edittext_background"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:imeOptions="actionSearch" />

                        <LinearLayout
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/filter_icon_background"
                            android:gravity="center"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_filter"
                                android:tint="#FFFFFF" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Bouton Apply/Clear Filter -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyClearFilter"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Apply Filter"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/purple_500"
                        app:cornerRadius="8dp"
                        android:textAllCaps="false" />

                </LinearLayout>

                <!-- Employee List -->
                <ListView
                    android:id="@+id/lstEmployee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="6dp"
                    android:scrollbars="none"/>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/activity_main_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>