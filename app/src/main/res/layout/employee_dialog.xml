<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_margin="20dp">

    <!-- Simulation de coins arrondis avec des bordures -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/button_border"
        android:padding="2dp">

        <!-- Carte principale -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="0dp">

            <!-- En-tête Employee avec photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FAFAFA"
                android:padding="20dp"
                android:gravity="center_vertical">

                <!-- Image de profil -->
                <ImageView
                    android:id="@+id/imgDialogEmployee"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_person_placeholder"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/circle_background" />

                <!-- Nom de l'employé -->
                <TextView
                    android:id="@+id/txtDialogEmployeeName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Employee Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Zone de contenu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">

                <!-- Role avec effet arrondi simulé -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/button_border"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Role:"
                        android:textSize="15sp"
                        android:textColor="#666666"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/txtDialogEmployeeRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Collaborator"
                        android:textSize="15sp"
                        android:textColor="#D32F2F"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Location avec effet arrondi simulé -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/button_border"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address:"
                        android:textSize="15sp"
                        android:textColor="#666666"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/txtDialogEmployeeAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Route Mahdia, Sfax,Tunis"
                        android:textSize="15sp"
                        android:textColor="#666666" />

                </LinearLayout>

                <!-- Boutons avec coins arrondis simulés -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:gravity="center"
                    android:padding="8dp"
                    >

                    <!-- View Details Button -->
                    <LinearLayout
                        android:id="@+id/btnViewDetails"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_background_blue"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:foreground="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Details"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textAllCaps="false" />

                    </LinearLayout>

                    <!-- Edit Button -->
                    <LinearLayout
                        android:id="@+id/btnEdit"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_background_yellow"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:foreground="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textAllCaps="false" />

                    </LinearLayout>

                    <!-- Delete Button -->
                    <LinearLayout
                        android:id="@+id/btnDelete"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_background_red"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:foreground="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delete"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textAllCaps="false" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>