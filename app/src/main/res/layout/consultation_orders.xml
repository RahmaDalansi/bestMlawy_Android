<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Barre de titre moderne -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#C62828"
        android:paddingHorizontal="22dp"
        android:gravity="center_vertical"
        android:elevation="6dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Orders List"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.05" />

        <ImageView
            android:id="@+id/imgScanQr"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_qr_code"
            android:background="@drawable/bg_icon_circle"
            android:padding="12dp"
            android:contentDescription="Scanner un code QR"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Barre de recherche modernisée -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:elevation="3dp"
        android:padding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_round_white_large">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#9E9E9E"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="10dp"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:hint="Rechercher par ID..."
            android:textSize="16sp"
            android:background="@drawable/bg_round_edittext"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <ImageView
            android:id="@+id/imgFilter"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@drawable/bg_round_red_large"
            android:padding="14dp"
            android:contentDescription="Filter Orders"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Lien filtres modernisé -->
    <TextView
        android:id="@+id/txtOpenFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter Orders"
        android:textColor="#C62828"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_round_gray_light"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="4dp"
        android:layout_gravity="end"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:elevation="2dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Liste des commandes modernisée -->
    <ListView
        android:id="@+id/lstOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:padding="8dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_round_white_large"
        android:clipToPadding="false"
        android:elevation="2dp"
        android:scrollbars="none" />

</LinearLayout>