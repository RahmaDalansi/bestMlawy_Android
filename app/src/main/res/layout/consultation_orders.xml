<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Barre d'onglets : En cours | Prêt | Livré -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tabEnCours"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="En cours"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/tab_selected_red"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabPret"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Prêt"
            android:textColor="#757575"
            android:textSize="15sp"
            android:textStyle="normal"
            android:gravity="center"
            android:background="@drawable/tab_unselected"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabLivré"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Livré"
            android:textColor="#757575"
            android:textSize="15sp"
            android:textStyle="normal"
            android:gravity="center"
            android:background="@drawable/tab_unselected"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Barre de recherche -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:elevation="2dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_round_gray_search">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#757575"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="10dp"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:hint="Search"
            android:textSize="16sp"
            android:background="@null"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#212121"
            android:textColorHint="#9E9E9E" />

        <!-- Bouton filtre avec ID txtOpenFilters -->
        <ImageView
            android:id="@+id/txtOpenFilters"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_filter_list"
            android:background="@drawable/bg_round_red_small"
            android:padding="10dp"
            android:contentDescription="Filter Orders"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Ligne Scan QR -->
    <!-- Bouton Scan QR en pleine largeur -->
    <Button
        android:id="@+id/btnScanQr"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_round_red_small"
        android:text="Scanner un QR Code"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:drawableStart="@drawable/ic_qr_code"
        android:drawablePadding="12dp"
        android:gravity="center_vertical|start"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Scanner un code QR" />

    <!-- Liste des commandes -->
    <ListView
        android:id="@+id/lstOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="0.5dp"
        android:scrollbars="vertical" />

</LinearLayout>