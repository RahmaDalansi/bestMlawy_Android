<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/languageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Language"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select your preferred language. This will change the language throughout the app."
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <!-- Select Language Label -->
        <TextView
            android:id="@+id/selectLanguageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Language:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Language Spinner -->
        <Spinner
            android:id="@+id/languageSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="32dp" />

        <!-- Apply Button -->
        <Button
            android:id="@+id/applyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Changes"
            android:textAllCaps="false"
            android:backgroundTint="@color/purple_500"
            android:textColor="@android:color/white"
            android:layout_marginBottom="32dp" />

        <!-- Other Settings Section -->
        <TextView
            android:id="@+id/otherSettingsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Other Settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Feature 1 -->
        <LinearLayout
            android:id="@+id/feature1Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="@drawable/rounded_border">

            <TextView
                android:id="@+id/feature1Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/feature1Desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receive notifications about new orders and updates"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray" />
        </LinearLayout>

        <!-- Dark/Light Mode Toggle -->
        <LinearLayout
            android:id="@+id/themeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="@drawable/rounded_border"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/themeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Theme"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/themeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:checked="false" />
        </LinearLayout>

        <!-- Feature 3 -->
        <LinearLayout
            android:id="@+id/feature3Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="@drawable/rounded_border">

            <TextView
                android:id="@+id/feature3Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Sync"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/feature3Desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Synchronize data automatically with cloud"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>