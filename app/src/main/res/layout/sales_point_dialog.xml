<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/edtSpName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name" />

        <EditText
            android:id="@+id/edtSpAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/edtSpCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="City"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/edtSpPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/edtSpOpeningHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Opening hours"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtSpCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap on the map to select coordinates"
            android:layout_marginTop="12dp" />

        <WebView
            android:id="@+id/webSpPickerMap"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
